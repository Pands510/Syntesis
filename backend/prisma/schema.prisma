generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ALUNO
  PROFESSOR
  ADMIN
}

enum EnrollmentStatus {
  ATIVA
  CONCLUIDA
  CANCELADA
}

enum Shift {
  MANHA
  TARDE
}

enum WeekDay {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
}

enum AcademicUnit {
  U1
  U2
  U3
}

enum AssessmentNumber {
  AVALIACAO1
  AVALIACAO2
  AVALIACAO3
}

enum AttendanceStatus {
  PRESENTE
  FALTA
  JUSTIFICADA
}

enum StudentStatus {
  ATIVO
  TRANCADO
  CONCLUIDO
}

enum AcademicHistoryType {
  INGRESSO
  TRANCAMENTO
  RETORNO
  TRANSFERENCIA
  CONCLUSAO
  PROGRESSAO
}

enum AcademicTermStatus {
  PLANEJADO
  EM_ANDAMENTO
  ENCERRADO
}

enum AnnouncementTargetType {
  TODOS
  ALUNOS
  CURSO
  TODAS_TURMAS
  TURMA
  ALUNO
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  isActive     Boolean  @default(true)

  student   Student?
  professor Professor?

  announcementsAuthored  Announcement[]          @relation("AnnouncementAuthor")
  announcementRecipients AnnouncementRecipient[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model Student {
  id                 String  @id @default(uuid())
  userId             String  @unique
  registrationNumber String? @unique

  // Campo antigo mantido durante a transiÃ§Ã£o
  course   String?
  semester Int?
  status   StudentStatus @default(ATIVO)

  // Novo relacionamento com Course
  courseId String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  academicCourse Course? @relation(fields: [courseId], references: [id], onDelete: SetNull)

  enrollments     Enrollment[]
  academicHistory AcademicHistory[]

  targetAnnouncements Announcement[] @relation("AnnouncementStudent")

  @@map("students")
}

model AcademicHistory {
  id               String              @id @default(uuid())
  studentId        String
  type             AcademicHistoryType
  previousCourseId String?
  newCourseId      String?
  academicTermId   String?
  semester         Int?
  description      String?
  occurredAt       DateTime            @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Restrict)

  previousCourse Course?       @relation("PreviousCourse", fields: [previousCourseId], references: [id], onDelete: Restrict)
  newCourse      Course?       @relation("NewCourse", fields: [newCourseId], references: [id], onDelete: Restrict)
  academicTerm   AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())

  @@unique([studentId, academicTermId, type])
  @@index([studentId, occurredAt])
  @@index([academicTermId])
  @@map("academic_history")
}

model Professor {
  id                  String  @id @default(uuid())
  userId              String  @unique
  employeeNumber      String? @unique
  department          String?
  scheduleLockVersion Int     @default(0)

  disciplineId String?
  discipline   Discipline? @relation(fields: [disciplineId], references: [id], onDelete: Restrict)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes SchoolClass[]

  @@map("professors")
}

model Course {
  id             String  @id @default(uuid())
  name           String  @unique
  code           String? @unique
  description    String?
  mainShift      Shift?
  isActive       Boolean @default(true)
  totalSemesters Int     @default(1)

  students    Student[]
  disciplines Discipline[]

  targetAnnouncements Announcement[] @relation("AnnouncementCourse")

  previousAcademicHistories AcademicHistory[] @relation("PreviousCourse")
  newAcademicHistories      AcademicHistory[] @relation("NewCourse")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("courses")
}

model Discipline {
  id            String  @id @default(uuid())
  name          String
  code          String  @unique
  workloadHours Int
  semester      Int     @default(1)
  isActive      Boolean @default(true)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Restrict)

  classes    SchoolClass[]
  professors Professor[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, courseId])
  @@map("disciplines")
}

model AcademicTerm {
  id         String             @id @default(uuid())
  name       String
  year       Int
  termNumber Int
  startDate  DateTime
  endDate    DateTime
  status     AcademicTermStatus @default(PLANEJADO)

  schoolClasses   SchoolClass[]
  academicHistory AcademicHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, termNumber])
  @@map("academic_terms")
}

model SchoolClass {
  id             String  @id @default(uuid())
  name           String
  code           String  @unique
  academicYear   Int
  term           Int
  semester       Int?
  isActive       Boolean @default(true)
  disciplineId   String
  professorId    String
  academicTermId String?

  discipline   Discipline    @relation(fields: [disciplineId], references: [id], onDelete: Restrict)
  professor    Professor     @relation(fields: [professorId], references: [id], onDelete: Restrict)
  academicTerm AcademicTerm? @relation(fields: [academicTermId], references: [id], onDelete: Restrict)

  enrollments     Enrollment[]
  scheduleEntries ScheduleEntry[]
  assessments     Assessment[]

  targetAnnouncements Announcement[] @relation("AnnouncementClass")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([disciplineId, academicTermId])
  @@map("school_classes")
}

model Enrollment {
  id         String           @id @default(uuid())
  studentId  String
  classId    String
  status     EnrollmentStatus @default(ATIVA)
  enrolledAt DateTime         @default(now())

  student     Student     @relation(fields: [studentId], references: [id], onDelete: Restrict)
  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Restrict)

  grades         Grade[]
  finalExamGrade FinalExamGrade?
  attendances    Attendance[]

  @@unique([studentId, classId])
  @@map("enrollments")
}

model ScheduleEntry {
  id String @id @default(uuid())

  classId      String
  weekDay      WeekDay
  shift        Shift
  lessonNumber Int

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([classId, weekDay, shift, lessonNumber])
  @@map("schedule_entries")
}

model Assessment {
  id      String           @id @default(uuid())
  classId String
  unit    AcademicUnit
  number  AssessmentNumber
  title   String

  schoolClass SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  grades      Grade[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Impede mais de trÃªs avaliaÃ§Ãµes por unidade na mesma turma.
  @@unique([classId, unit, number])
  @@map("assessments")
}

model Grade {
  id           String  @id @default(uuid())
  assessmentId String
  enrollmentId String
  score        Decimal @db.Decimal(4, 2)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Uma nota por aluno em cada avaliaÃ§Ã£o.
  @@unique([assessmentId, enrollmentId])
  @@map("grades")
}

model FinalExamGrade {
  id           String  @id @default(uuid())
  enrollmentId String  @unique
  score        Decimal @db.Decimal(4, 2)

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("final_exam_grades")
}

model Attendance {
  id           String           @id @default(uuid())
  enrollmentId String
  date         DateTime         @db.Date
  shift        Shift
  lessonNumber Int
  status       AttendanceStatus

  enrollment Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([enrollmentId, date, shift, lessonNumber])
  @@map("attendances")
}

model Announcement {
  id          String                 @id @default(uuid())
  authorId    String
  title       String
  content     String                 @db.Text
  targetType  AnnouncementTargetType
  courseId    String?
  classId     String?
  studentId   String?
  isActive    Boolean                @default(true)
  publishedAt DateTime               @default(now())

  author        User         @relation("AnnouncementAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  targetCourse  Course?      @relation("AnnouncementCourse", fields: [courseId], references: [id], onDelete: SetNull)
  targetClass   SchoolClass? @relation("AnnouncementClass", fields: [classId], references: [id], onDelete: SetNull)
  targetStudent Student?     @relation("AnnouncementStudent", fields: [studentId], references: [id], onDelete: SetNull)

  recipients AnnouncementRecipient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId, publishedAt])
  @@index([targetType, publishedAt])
  @@map("announcements")
}

model AnnouncementRecipient {
  id             String    @id @default(uuid())
  announcementId String
  userId         String
  readAt         DateTime?

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([announcementId, userId])
  @@index([userId, readAt])
  @@map("announcement_recipients")
}
